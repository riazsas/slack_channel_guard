# Bot token (OAuth & Permissions -> Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token with the connections:write scope (Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-your-app-level-token

# Comma-separated Slack user IDs allowed to run /channel-guard.
# They are always treated as authorized inviters. (Profile -> ... -> Copy member ID)
BOT_ADMIN_IDS=U0123ABCD,U0456EFGH

# Where lock/allowlist state is saved. Mount this path on a persistent volume in production.
DATA_FILE=./data/state.json

# Optional: channel ID to post an audit line each time someone is removed (bot must be a member).
LOG_CHANNEL_ID=

# Optional: if true, a user who joins a locked channel with no inviter (self-join) and who is
# not on the allowlist is also removed. Default false (self-joins are logged, not removed).
KICK_SELF_JOINS=false

# Optional: if true, log what would happen but never call conversations.kick.
DRY_RUN=false
